{
  "name": "nmstate-console-plugin",
  "version": "0.0.1",
  "private": true,
  "repository": "git@github.com:upalatucci/nmstate-console-plugin.git",
  "license": "Apache-2.0",
  "types": "./src/types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "start": "npm run dev",
    "build": "npm run clean && NODE_ENV=production npm run webpack",
    "serve-build": "npm run build && npx http-server -p 9001 dist",
    "dev": "npm run webpack serve",
    "webpack": "webpack",
    "start-console": "./start-console.sh",
    "cypress": "cypress run --browser electron",
    "cypress:open": "cypress open",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "lint": "eslint --max-warnings=0 . && prettier --ignore-unknown --check .",
    "lint:fix": "eslint --max-warnings=0 --fix . && prettier --ignore-unknown --write .",
    "test": "jest",
    "test-cypress-headless": "node --max-old-space-size=4096 ./node_modules/.bin/cypress run --env openshift=true --browser ${BRIDGE_E2E_BROWSER_NAME:=electron}",
    "test:coverage": "jest --coverage",
    "test:updateSnapshot": "jest --updateSnapshot",
    "download-crds": "cd ./src/nmstate-types && ./download-nmstate-crds.sh && cd ../..",
    "helm:lint": "helm lint deployment/nmstate-console-plugin/",
    "helm:build": "mkdir -p tmp && helm package -d tmp deployment/nmstate-console-plugin/",
    "i18n-to-po": "node ./i18n-scripts/i18n-to-po.js",
    "po-to-i18n": "node ./i18n-scripts/po-to-i18n.js",
    "shared-modules:check": "./scripts/check-shared-modules.sh",
    "shared-modules:sync": "./scripts/align-shared-modules.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@openshift-console/dynamic-plugin-sdk-internal": "4.21.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.21.0",
    "@openshift/dynamic-plugin-sdk": "5.0.1",
    "@openshift/dynamic-plugin-sdk-webpack": "4.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^28.1.6",
    "@types/js-yaml": "^4.0.1",
    "@types/node": "^18.0.0",
    "@types/react": "^17.0.40",
    "@types/react-router": "^5.1.15",
    "@types/react-router-dom": "^5.3.2",
    "css-loader": "^6.7.1",
    "cypress": "15.21.1",
    "esbuild-loader": "^4.5.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "http-server": "^14.1.1",
    "i18next-parser": "^9.4.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "mini-svg-data-uri": "^1.4.4",
    "mocha": "12.0.3",
    "pluralize": "^8.0.0",
    "prettier": "3.9.9",
    "sass": "^1.105.1",
    "sass-loader": "16.0.8",
    "style-loader": "^3.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "^10.8.1",
    "tsconfig-paths-webpack-plugin": "^4.0.0",
    "typescript": "5.9.x",
    "typescript-eslint": "8.71.1",
    "webpack": "5.111.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "@kubevirt-ui-ext/kubevirt-api": "2.1.5",
    "@openshift-console/dynamic-plugin-sdk": "4.21.0",
    "@patternfly/react-catalog-view-extension": "6.1.0",
    "@patternfly/react-component-groups": "6.2.0-prerelease.10",
    "@patternfly/react-core": "6.2.3",
    "@patternfly/react-data-view": "6.2.0",
    "@patternfly/react-drag-drop": "6.2.0",
    "@patternfly/react-icons": "6.2.2",
    "@patternfly/react-styles": "6.2.2",
    "@patternfly/react-table": "6.2.3",
    "@patternfly/react-templates": "6.2.3",
    "@patternfly/react-tokens": "6.2.2",
    "@patternfly/react-topology": "6.2.0",
    "@preact/signals-react": "^3.12.0",
    "classnames": "^2.5.1",
    "immer": "^9.0.16",
    "react": "17.0.1",
    "react-dom": "17.0.2",
    "react-i18next": "11.18.6",
    "react-redux": "7.2.9",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "react-router-dom-v5-compat": "6.11.2",
    "redux": "4.0.4",
    "redux-thunk": "2.4.0",
    "use-immer": "^0.11.0"
  },
  "overrides": {
    "react": "$react",
    "@patternfly/react-component-groups": "$@patternfly/react-component-groups",
    "@patternfly/react-core": "$@patternfly/react-core",
    "@patternfly/react-icons": "$@patternfly/react-icons"
  }
}
